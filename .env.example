# =============================================================================
# AI Inventory & Operations Intelligence System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git. It is in .gitignore.
# All variables must be set before running docker-compose up.
# =============================================================================

# =============================================================================
# Application
# =============================================================================
APP_ENV=development                    # development | staging | production
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=your-secret-key-here        # Generate with: openssl rand -hex 32

# =============================================================================
# Database — PostgreSQL 15
# =============================================================================
# Individual components are combined in app/core/settings.py into a DATABASE_URL
POSTGRES_HOST=localhost                 # Use 'postgres' when running in Docker
POSTGRES_PORT=5432
POSTGRES_DB=inventory_ops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme             # REQUIRED — set a strong password

# =============================================================================
# Redis 7 — Celery broker, result backend, and cache
# =============================================================================
REDIS_HOST=localhost                   # Use 'redis' when running in Docker
REDIS_PORT=6379
REDIS_DB=0                             # Database index (0-15)

# Explicit broker/backend URLs (constructed from above in settings.py)
# These override individual components if set directly
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# Shopify Integration
# =============================================================================
SHOPIFY_API_KEY=                       # From Shopify Partner dashboard
SHOPIFY_API_SECRET=                    # From Shopify Partner dashboard
SHOPIFY_STORE_DOMAIN=bluorng.myshopify.com
SHOPIFY_WEBHOOK_SECRET=               # HMAC secret for webhook validation
SHOPIFY_API_VERSION=2024-01           # Shopify API version to use

# =============================================================================
# WhatsApp Business API (360dialog or Wati)
# =============================================================================
WHATSAPP_API_URL=                      # Provider API base URL
WHATSAPP_API_KEY=                      # Provider API key
WHATSAPP_PHONE_NUMBER=                 # Business phone number (with country code)

# =============================================================================
# Google Sheets API
# =============================================================================
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials/google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=         # Target spreadsheet ID from URL

# =============================================================================
# Slack Integration
# =============================================================================
SLACK_WEBHOOK_URL=                     # Incoming webhook URL from Slack app settings
SLACK_CHANNEL=#inventory-alerts       # Default channel for alerts

# =============================================================================
# SendGrid — Email notifications
# =============================================================================
SENDGRID_API_KEY=                      # SendGrid API key (starts with SG.)
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Inventory System

# =============================================================================
# OpenAI — AI-powered features
# =============================================================================
OPENAI_API_KEY=                        # OpenAI API key (starts with sk-)
OPENAI_MODEL=gpt-4o-mini               # Model to use for AI features

# =============================================================================
# Sentry — Error tracking (optional in development)
# =============================================================================
SENTRY_DSN=                            # Leave empty to disable Sentry

# =============================================================================
# Celery Task Configuration
# =============================================================================
CELERY_TASK_TIME_LIMIT=300             # Hard time limit per task (seconds)
CELERY_TASK_MAX_RETRIES=3             # Max retry attempts per task
CELERY_RESULT_EXPIRES=86400           # Result expiry in seconds (24 hours)
